{
  "name": "splat-server",
  "private": true,
  "version": "0.6.1",
  "license": "Apache-2.0",
  "author": "ooolabdev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ooolabdev/ooosplat.git"
  },
  "type": "module",
  "scripts": {
    "build": "cargo build --release --locked --manifest-path src-tauri/Cargo.toml --bin splatstudio",
    "test": "python3 -m unittest discover -s tests -v && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "setup:engines": "bash scripts/setup-engines-linux.sh",
    "verify:engines": "bash scripts/verify-engines-linux.sh",
    "build:engines:linux": "bash scripts/build-native-linux.sh",
    "verify:colmap-lock": "node scripts/verify-colmap-lock.mjs",
    "test:engine-scripts": "node --test scripts/colmap-runtime.test.mjs scripts/cuda-toolkit.test.mjs scripts/collect-linux-runtime.test.mjs scripts/brush-runtime.test.mjs",
    "setup:native": "bash scripts/build-native-linux.sh"
  },
  "description": "Headless video reconstruction and Gaussian Splatting pipeline"
}
